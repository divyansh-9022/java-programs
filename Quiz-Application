import java.util.Scanner;

public class QuizApplication {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String[] questions = {
                "Which language is used for Android development?\nA. Java\nB. HTML\nC. SQL\nD. CSS",

                "Which data structure follows FIFO?\nA. Stack\nB. Queue\nC. Tree\nD. Graph",

                "Which keyword is used to inherit a class in Java?\nA. implements\nB. inherits\nC. extends\nD. super",

                "Which database language is used to retrieve data?\nA. SQL\nB. HTML\nC. CSS\nD. XML",

                "Which algorithm is used to find an element in a sorted array?\nA. Linear Search\nB. Binary Search\nC. Bubble Sort\nD. Selection Sort"
        };

        char[] answers = {'A', 'B', 'C', 'A', 'B'};

        int score = 0;

        System.out.println("===== JAVA & COMPUTER SCIENCE QUIZ =====");

        for (int i = 0; i < questions.length; i++) {

            System.out.println("\nQuestion " + (i + 1));
            System.out.println(questions[i]);

            System.out.print("Your answer: ");
            char answer = Character.toUpperCase(sc.next().charAt(0));

            if (answer == answers[i]) {
                System.out.println("Correct!");
                score++;
            } else {
                System.out.println("Wrong!");
                System.out.println("Correct answer: " + answers[i]);
            }
        }

        System.out.println("\n===== QUIZ RESULT =====");
        System.out.println("Score: " + score + "/" + questions.length);

        double percentage =
                (score * 100.0) / questions.length;

        System.out.println("Percentage: " + percentage + "%");

        if (percentage >= 80) {
            System.out.println("Excellent!");
        } else if (percentage >= 60) {
            System.out.println("Good job!");
        } else if (percentage >= 40) {
            System.out.println("Keep practicing!");
        } else {
            System.out.println("Need more practice.");
        }

        sc.close();
    }
}
